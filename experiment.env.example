# Configuracao local do experimento. Copie para experiment.env e ajuste.
# O experiment.env fica fora do git: ninguem precisa editar arquivo versionado.
#
# A forma ":" ${VAR:=valor}" so define a variavel se ela ainda nao veio do
# ambiente, entao um override pontual continua funcionando:
#   SOURCE_DIR=/outro/caminho ./execucao_safer.sh

# Projetos com os testes gerados (EvoSuite e Kex) -- a entrada do experimento.
: "${SOURCE_DIR:=$PWD/../analise-geracao-testes/projects}"

# Onde cada projeto e copiado para ser executado.
: "${DEST_DIR:=$PWD/workstation/maven}"

# Categorias de teste desta execucao: native, evosuite, kex (ou combinacoes).
# Define o layout montado em cada copia e o nome dos arquivos de resultado.
: "${COMBINATION:=native,kex}"
